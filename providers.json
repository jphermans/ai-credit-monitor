{
  "version": 1,
  "updated": "2026-08-09",
  "providers": [
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "version": "1.0.0",
      "description": "AI model router with credit-based billing",
      "auth": {
        "type": "bearer",
        "keyLabel": "OpenRouter API Key",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "request": {
        "method": "GET",
        "url": "https://openrouter.ai/api/v1/credits"
      },
      "response": {
        "mode": "difference",
        "totalPath": "data.total_credits",
        "usedPath": "data.total_usage",
        "currency": "USD",
        "label": "Remaining credits",
        "errorPath": "error.message"
      },
      "alerts": {
        "redThreshold": 1,
        "orangeThreshold": 5
      }
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "version": "1.0.0",
      "description": "DeepSeek AI models",
      "auth": {
        "type": "bearer",
        "keyLabel": "DeepSeek API Key",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "request": {
        "method": "GET",
        "url": "https://api.deepseek.com/user/balance"
      },
      "response": {
        "mode": "array",
        "arrayPath": "balance_infos",
        "amountField": "total_balance",
        "currencyField": "currency",
        "preferredCurrency": "USD",
        "label": "Account balance",
        "errorPath": "error.message"
      },
      "alerts": {
        "redThreshold": 1,
        "orangeThreshold": 5
      }
    },
